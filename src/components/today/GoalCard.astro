---
import GoalIcon from '@/components/icons/GoalIcon.astro';
import type { TodayGoalView } from '@/lib/today-view';

/**
 * Una tarjeta por objetivo activo.
 *
 * Componente Astro, no React: es un enlace con datos del servidor y no necesita
 * estado. Cero JavaScript.
 *
 * Pinta dos estados. Un objetivo **programado hoy** es lo que el usuario viene a
 * resolver y va con los colores de marca. Uno **no programado** se recoge a un
 * plano secundario: sigue ahí para que la pantalla tenga cuerpo y para que se
 * vea de un vistazo qué hay configurado, sin competir con lo que toca hoy.
 *
 * **La diferencia se hace con fondo y color de texto, no con `opacity` ni
 * `grayscale`.** Un `opacity-60` sobre la tarjeta entera multiplica el contraste
 * de todo lo que lleva dentro: `text-text-soft` sobre `surface` cumple AA por los
 * pelos, y al 60 % se queda por debajo. Recoger el fondo a `muted` y el texto a
 * `text-soft` consigue el mismo efecto de "esto es secundario" sin tocar ni un
 * ratio de contraste.
 */
interface Props {
  goal: TodayGoalView;
}

const { goal } = Astro.props;

/*
 * Un objetivo en pausa se pinta como un día libre: en lo que al usuario le
 * importa hoy —si esto le va a costar un perrito— son el mismo caso, y el motor
 * los resuelve con la misma acción. Lo que cambia es la etiqueta, porque el
 * motivo no es el mismo y la pausa se quita desde Ajustes.
 *
 * El interruptor NO está aquí. Esta tarjeta es un componente Astro sin una línea
 * de JavaScript, y meterle un control interactivo obligaría a hidratar una isla
 * por objetivo en la pantalla de entrada. La pausa se cambia en `/ajustes`, que
 * es donde ya se configura todo lo demás del objetivo; aquí solo se informa.
 */
const enPausa = goal.isPaused;
const libre = enPausa || !goal.isScheduledToday;
const progreso = Math.min(1, goal.today.minutes / goal.dailyGoalMinutes);

/*
 * El CTA dice lo que va a pasar.
 *
 * En un día libre sigue siendo un enlace vivo, no un botón deshabilitado, y la
 * razón es de reglas del juego: un día no programado **nunca** penaliza, y los
 * minutos que se le echen sí otorgan perritos. Bloquear el enlace no protegería
 * de nada —no hay nada de lo que proteger— y quitaría la sesión extra, que es
 * una función que ya existe y que el motor premia.
 *
 * Lo que sí cambia es el peso visual: relleno de marca cuando toca, contorno
 * cuando no. La etiqueta «Día libre» de la cabecera es la que comunica el
 * estado, con texto y no solo con color.
 */
const cta = goal.hasOpenSession
  ? 'Retomar sesión'
  : goal.today.completed
    ? 'Seguir sumando'
    : libre
      ? 'Sumar de todos modos'
      : 'Empezar sesión';
---

<article
  class:list={[
    'rounded-card border p-5',
    libre ? 'border-border bg-muted' : 'border-border bg-surface',
  ]}
>
  <div class="flex items-start gap-3">
    <span class:list={['mt-0.5 shrink-0', libre ? 'text-text-soft' : 'text-primary']}>
      <GoalIcon type={goal.type} />
    </span>

    <div class="min-w-0 grow">
      <h3 class:list={['font-semibold', libre && 'text-text-soft']}>{goal.label}</h3>
      {goal.context && <p class="truncate text-sm text-text-soft">{goal.context}</p>}
    </div>

    {/* El estado lleva símbolo y texto, nunca solo color. */}
    {
      goal.today.completed ? (
        <span class="shrink-0 text-sm font-medium text-primary">
          <span aria-hidden>✓</span> Hecho
        </span>
      ) : enPausa ? (
        <span class="shrink-0 text-sm font-medium text-text-soft">
          <span aria-hidden>⏸</span> En pausa
        </span>
      ) : (
        libre && (
          <span class="shrink-0 text-sm font-medium text-text-soft">
            <span aria-hidden>·</span> Día libre
          </span>
        )
      )
    }
  </div>

  {/* Una razón contra un límite: un medidor, no una gráfica. */}
  <div
    role="meter"
    aria-valuenow={goal.today.minutes}
    aria-valuemin={0}
    aria-valuemax={goal.dailyGoalMinutes}
    aria-label={`${goal.label}: ${goal.today.minutes} de ${goal.dailyGoalMinutes} minutos`}
    class:list={[
      'mt-4 h-2 w-full overflow-hidden rounded-full',
      // Sobre una tarjeta `muted`, un carril `muted` sería invisible.
      libre ? 'bg-border' : 'bg-muted',
    ]}
  >
    <div
      class="h-full rounded-full bg-primary transition-[width] duration-500"
      style={`width:${progreso * 100}%`}
    >
    </div>
  </div>

  <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
    <p class="text-sm text-text-soft">
      <span class="tabular-nums">{goal.today.minutes}</span> / {goal.dailyGoalMinutes} min
      <span aria-hidden> · </span>
      <span class="tabular-nums">{goal.shelter.dogs}</span> 🐶
      <span class="sr-only">perritos en el refugio</span>
    </p>

    {/*
      Enlace, no botón con `onClick`: así funciona con el ClientRouter, con
      "abrir en pestaña nueva" y sin JavaScript.
    */}
    <a
      href={`/sesion/${goal.goalId}`}
      class:list={[
        'flex min-h-11 items-center rounded-card px-4 text-sm font-medium transition',
        libre
          ? 'border border-border bg-surface text-text hover:border-primary hover:text-primary'
          : 'bg-primary text-on-primary hover:bg-primary-hover',
      ]}
    >
      {cta}
    </a>
  </div>
</article>
