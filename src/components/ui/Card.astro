---
interface Props {
  /** Título opcional de la tarjeta. */
  title?: string;
  class?: string;
}

const { title, class: className = '' } = Astro.props;
---

<section class:list={['rounded-card border border-border bg-surface p-6', className]}>
  {title && <h2 class="mb-3 font-semibold">{title}</h2>}
  <slot />
</section>
