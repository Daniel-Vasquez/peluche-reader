---
import AppLayout from '@/layouts/AppLayout.astro';
import Card from '@/components/ui/Card.astro';
import GoalProgressPanel from '@/components/progress/GoalProgressPanel.astro';
import GoalTabPanel from '@/components/progress/GoalTabPanel.astro';
import GoalTabs from '@/components/progress/GoalTabs.astro';
import { syncAllGoals } from '@/lib/game/service';
import { vocabularyFor } from '@/lib/game/vocabulary';
import { listGoals } from '@/lib/repos/goals';
import { buildProgressSummary } from '@/lib/repos/summary';

export const prerender = false;

const user = Astro.locals.user!;

// Reconcilia los días cerrados también aquí: el usuario puede entrar directo a
// /progreso sin pasar por /app, y vería cifras sin las penalizaciones al día.
await syncAllGoals(user.id);

const goals = await listGoals(user.id);
const resumenes = await Promise.all(
  goals.map(async (goal) => ({
    goal,
    summary: await buildProgressSummary({ userId: user.id, goalId: goal.goalId }, 30),
  })),
);
---

<AppLayout title="Progreso" subheading="Días cumplidos, tiempo acumulado y tu refugio, objetivo por objetivo.">
  {
    goals.length === 0 ? (
      <Card>
        <p class="text-text-soft">
          No tienes objetivos activos. Configúralos en{' '}
          <a class="font-medium text-primary hover:underline" href="/ajustes">Ajustes</a>.
        </p>
      </Card>
    ) : (
      <GoalTabs tabs={goals.map((g) => ({ id: g.goalId, label: g.label, type: g.type }))}>
        {resumenes.map(({ goal, summary }, i) => (
          <GoalTabPanel id={goal.goalId} activo={i === 0}>
            <GoalProgressPanel
              summary={summary}
              label={goal.label}
              dailyGoalMinutes={goal.dailyGoalMinutes}
              activity={vocabularyFor(goal.type).activity}
            />
          </GoalTabPanel>
        ))}
      </GoalTabs>
    )
  }
</AppLayout>
