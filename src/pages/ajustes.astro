---
import AppLayout from '@/layouts/AppLayout.astro';
import Card from '@/components/ui/Card.astro';
import GoalAccordion from '@/components/settings/GoalAccordion.astro';
import ProfileSettingsForm from '@/components/settings/ProfileSettingsForm';
import { ensureDefaultGoals, listGoals } from '@/lib/repos/goals';
import { ensureProfile, updateProfile } from '@/lib/repos/profile';

export const prerender = false;

const user = Astro.locals.user!;
const profile = await ensureProfile(user.id);
await ensureDefaultGoals(user.id);
const goals = await listGoals(user.id);

const onboarding = profile.onboardedAt === null;

/*
 * El onboarding se cierra al ENTRAR, no al guardar.
 *
 * Con un solo hábito, el primer guardado era la señal de que el usuario había
 * elegido sus días. Con varios objetivos no hay un "primer guardado" único: cada
 * acordeón se guarda por su cuenta, y Lectura ya viene con días por defecto. Que
 * haya visto esta pantalla es señal suficiente.
 */
if (onboarding) await updateProfile(user.id, {});
---

<AppLayout
  title="Ajustes"
  heading={onboarding ? 'Prepara tus objetivos' : 'Ajustes'}
  subheading={
    onboarding
      ? 'Elige qué días te comprometes a cada cosa. Lo que dejes sin días queda inactivo.'
      : 'Tu cuenta y la configuración de cada objetivo.'
  }
>
  <Card title="Tu cuenta">
    <ProfileSettingsForm
      client:load
      initialName={user.name}
      initialTimezone={profile.timezone}
    />
  </Card>

  <h2 class="mt-8 mb-3 text-sm font-medium tracking-wide text-text-soft uppercase">
    Objetivos
  </h2>

  {
    goals.length === 0 ? (
      <Card>
        <p class="text-text-soft">No tienes objetivos activos.</p>
      </Card>
    ) : (
      <div class="space-y-3">
        {goals.map((goal, i) => (
          // El primero abierto: con todos cerrados la pantalla no enseña nada
          // de lo que se puede hacer aquí.
          <GoalAccordion goal={goal} abierto={i === 0} />
        ))}
      </div>
    )
  }

  <p class="mt-6 text-sm text-text-soft">Cuenta: {user.email}</p>
</AppLayout>
