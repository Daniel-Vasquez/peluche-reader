---
import AppLayout from '@/layouts/AppLayout.astro';
import Card from '@/components/ui/Card.astro';

export const prerender = false;

const user = Astro.locals.user!;
---

<AppLayout
  title="Ajustes"
  subheading="Tu nombre, los días que te comprometes a leer y tu libro actual."
>
  <Card title="Cuenta">
    <dl class="grid gap-3 sm:grid-cols-2">
      <div>
        <dt class="text-sm text-text-soft">Nombre</dt>
        <dd class="mt-0.5 font-medium">{user.name}</dd>
      </div>
      <div>
        <dt class="text-sm text-text-soft">Correo</dt>
        <dd class="mt-0.5 font-medium">{user.email}</dd>
      </div>
    </dl>
    <p class="mt-4 text-text-soft">
      Editar el nombre y elegir tus días de lectura llega en la Tanda 4.
    </p>
  </Card>
</AppLayout>
