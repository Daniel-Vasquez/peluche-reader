---
import AppLayout from '@/layouts/AppLayout.astro';
import Card from '@/components/ui/Card.astro';
import Stat from '@/components/ui/Stat.astro';
import ReadingTimer from '@/components/ReadingTimer';
import Shelter from '@/components/Shelter';
import { syncOnVisit } from '@/lib/game/service';
import { ensureProfile } from '@/lib/repos/profile';
import {
  abandonStaleSessions,
  findOpenSession,
  MIN_SESSION_SECONDS,
} from '@/lib/repos/sessions';
import { toSessionView } from '@/lib/sessions-view';
import { firstName } from '@/lib/name';
import { WEEKDAY_LABELS, formatDuration } from '@/lib/time';

export const prerender = false;

const user = Astro.locals.user!;
const profile = await ensureProfile(user.id);

// Sin días comprometidos la gamificación no puede penalizar ni recompensar,
// así que el onboarding es obligatorio antes de ver el resto de la app.
if (profile.onboardedAt === null) {
  return Astro.redirect('/ajustes?onboarding=1', 302);
}

const now = new Date();

// Liquida las penalizaciones de los días ya cerrados antes de pintar nada.
const snapshot = await syncOnVisit(user.id, now);

// Cierra lo que quedó abierto hace horas antes de ofrecer retomar una sesión:
// si no, el usuario vería un cronómetro con el tiempo que pasó durmiendo.
await abandonStaleSessions(user.id, now);
const openSession = await findOpenSession(user.id);

const greeting = firstName(user.name);
const scheduledLabels = profile.scheduledDays.map((d) => WEEKDAY_LABELS[d].short);
const { shelter, today } = snapshot;
---

<AppLayout
  title="Hoy"
  heading={`Hola, ${greeting}`}
  subheading={
    today.scheduled
      ? 'Hoy te comprometiste a leer.'
      : 'Hoy es día libre: no leer no te cuesta ningún perrito.'
  }
>
  <Card>
    <Shelter
      client:load
      shelter={shelter}
      freshPenalties={snapshot.freshPenalties}
      ownerName={user.name}
    />
  </Card>

  <Card class="mt-4">
    <ReadingTimer
      client:load
      initialSession={openSession ? toSessionView(openSession, now) : null}
      bookTitle={profile.currentBookTitle}
      dailyGoalMinutes={profile.dailyGoalMinutes}
      minSessionSeconds={MIN_SESSION_SECONDS}
      initialDaySeconds={today.totalSeconds}
    />

    {
      profile.currentBookTitle && (
        <p class="mt-6 border-t border-border pt-4 text-center text-sm text-text-soft">
          Estás leyendo <span class="font-medium text-text">{profile.currentBookTitle}</span>
        </p>
      )
    }
  </Card>

  <dl class="mt-4 grid gap-4 sm:grid-cols-3">
    <Stat
      label="Tu compromiso"
      value={scheduledLabels.join(' · ')}
      hint={`${profile.scheduledDays.length} días a la semana`}
      tone="primary"
    />
    <Stat
      label="Leído hoy"
      value={formatDuration(today.totalSeconds)}
      hint={
        today.dogsAwarded > 0
          ? `${today.dogsAwarded} ${today.dogsAwarded === 1 ? 'perrito' : 'perritos'} ganados hoy`
          : `meta de ${profile.dailyGoalMinutes} min`
      }
      tone="accent"
    />
    <Stat
      label="Hoy"
      value={today.scheduled ? 'Día de lectura' : 'Día libre'}
      hint={today.dayKey}
      tone={today.scheduled ? 'primary' : 'neutral'}
    />
  </dl>
</AppLayout>
