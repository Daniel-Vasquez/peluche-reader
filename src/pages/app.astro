---
import AppLayout from '@/layouts/AppLayout.astro';
import TodayEmpty from '@/components/today/TodayEmpty.astro';
import TodayList from '@/components/today/TodayList.astro';
import { syncAllGoals } from '@/lib/game/service';
import { ensureProfile } from '@/lib/repos/profile';
import { buildTodayView } from '@/lib/today-view';
import { firstName } from '@/lib/name';
import { dayKey, isoWeekday } from '@/lib/time';

export const prerender = false;

const user = Astro.locals.user!;
const profile = await ensureProfile(user.id);

if (profile.onboardedAt === null) {
  return Astro.redirect('/ajustes?onboarding=1', 302);
}

const now = new Date();

// Reconcilia TODOS los objetivos antes de pintar: las penalizaciones de uno no
// pueden depender de que el usuario abra su pantalla.
await syncAllGoals(user.id, now);

const todayKey = dayKey(now, profile.timezone);
const weekday = isoWeekday(now, profile.timezone);
/*
 * `goals` son TODOS los objetivos activos, no solo los de hoy.
 *
 * El subtítulo y el estado vacío cuentan por separado: lo que el usuario tiene
 * que hacer hoy son los `programados`, pero la pantalla solo está de verdad
 * vacía si no hay ningún objetivo activo —todos archivados, o una cuenta recién
 * migrada—. Mezclar los dos casos era lo que hacía que un domingo pareciera un
 * error de la app.
 */
const goals = await buildTodayView(user.id, weekday, todayKey);

const programados = goals.filter((g) => g.isScheduledToday);
const pendientes = programados.filter((g) => !g.today.completed);
const greeting = firstName(user.name);

const subheading =
  goals.length === 0
    ? 'Todavía no tienes objetivos activos.'
    : programados.length === 0
      ? 'Hoy no te toca ninguno: descansa, que no pierdes ni un perrito.'
      : pendientes.length === 0
        ? '¡Todo hecho por hoy!'
        : pendientes.length === programados.length
          ? `Tienes ${programados.length} ${programados.length === 1 ? 'objetivo' : 'objetivos'} por delante.`
          : `Te ${pendientes.length === 1 ? 'queda' : 'quedan'} ${pendientes.length} de ${programados.length}.`;
---

<AppLayout title="Hoy" heading={`Hola, ${greeting}`} subheading={subheading}>
  {goals.length === 0 ? <TodayEmpty /> : <TodayList goals={goals} />}
</AppLayout>
