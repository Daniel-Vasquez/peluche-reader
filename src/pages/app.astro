---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SignOutButton from '@/components/auth/SignOutButton';

export const prerender = false;

// El middleware garantiza que exista usuario en las rutas protegidas.
const user = Astro.locals.user!;
---

<BaseLayout title="Hoy">
  <main class="mx-auto w-full max-w-3xl px-6 py-12">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h1 class="text-2xl font-semibold">Hola, {user.name}</h1>
        <p class="mt-1 text-text-soft">{user.email}</p>
      </div>
      <SignOutButton client:load />
    </div>

    <div class="mt-10 rounded-card border border-border bg-surface p-6">
      <p class="text-text-soft">
        Sesión activa. El cronómetro y el refugio llegan en las tandas 4–7.
      </p>
    </div>
  </main>
</BaseLayout>
