---
import AppLayout from '@/layouts/AppLayout.astro';
import Card from '@/components/ui/Card.astro';
import Stat from '@/components/ui/Stat.astro';
import { firstName } from '@/lib/name';
import { GAME_PREVIEW } from '@/lib/game/preview';

export const prerender = false;

const user = Astro.locals.user!;
const greeting = firstName(user.name);
---

<AppLayout
  title="Hoy"
  heading={`Hola, ${greeting}`}
  subheading="Aquí vivirán tu cronómetro y tu refugio."
>
  <Card title={`El refugio de ${user.name}`}>
    <p class="text-text-soft">
      El cronómetro de lectura llega en la Tanda 5 y los perritos en la Tanda 7.
    </p>
  </Card>

  <dl class="mt-4 grid gap-4 sm:grid-cols-3">
    <Stat
      label="Refugio inicial"
      value={GAME_PREVIEW.startDogs}
      hint="perritos a tu cuidado"
      tone="primary"
    />
    <Stat
      label="Umbral de recompensa"
      value={`${GAME_PREVIEW.baseMinutes} min`}
      hint="para ganar el primer perrito"
      tone="accent"
    />
    <Stat
      label="Día programado sin leer"
      value={`−${GAME_PREVIEW.penaltyPerMiss}`}
      hint="nunca baja de 1"
      tone="alert"
    />
  </dl>
</AppLayout>
