---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ThemeToggle from '@/components/ThemeToggle';
import SignOutButton from '@/components/auth/SignOutButton';
import { firstName } from '@/lib/name';
import { GAME_PREVIEW } from '@/lib/game/preview';

/*
 * Renderizado en servidor, no prerenderizada: la landing tiene que saber si ya
 * hay sesión. Ofrecer "Crear cuenta" a alguien que ya entró es desorientador, y
 * dejarle sin salida (ni toggle de tema ni cerrar sesión) lo es más.
 * El coste es mínimo: la página no consulta la base de datos.
 */
export const prerender = false;

const appName = import.meta.env.PUBLIC_APP_NAME ?? 'Peluche Reader';
const user = Astro.locals.user;
---

<BaseLayout title={appName}>
  <div class="mx-auto flex min-h-dvh w-full max-w-3xl flex-col px-6">
    <header class="flex items-center justify-between gap-4 py-5">
      <p class="text-sm font-semibold tracking-wide text-primary uppercase">
        {appName}
      </p>
      <div class="flex items-center gap-2">
        <ThemeToggle client:load />
        {user && <SignOutButton client:load />}
      </div>
    </header>

    <main class="flex grow flex-col justify-center py-10">
      <h1 class="text-4xl leading-tight font-semibold text-balance sm:text-5xl">
        Lee todos los días.
        <span class="text-primary">Salva a los perritos.</span>
      </h1>

      <p class="mt-5 max-w-xl text-lg text-pretty text-text-soft">
        Elige qué días te comprometes a leer, cronometra tus sesiones y mira crecer
        tu refugio. Cada día que fallas, un perrito se va; cada diez minutos que
        lees, vuelve a casa.
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        {
          user ? (
            <>
              <a
                href="/app"
                class="rounded-card bg-primary px-5 py-2.5 font-medium text-on-primary transition hover:bg-primary-hover"
              >
                Seguir leyendo, {firstName(user.name)}
              </a>
              <a
                href="/progreso"
                class="rounded-card border border-border bg-surface px-5 py-2.5 font-medium text-text transition hover:border-primary hover:text-primary"
              >
                Ver mi progreso
              </a>
            </>
          ) : (
            <>
              <a
                href="/registro"
                class="rounded-card bg-primary px-5 py-2.5 font-medium text-on-primary transition hover:bg-primary-hover"
              >
                Crear cuenta
              </a>
              <a
                href="/login"
                class="rounded-card border border-border bg-surface px-5 py-2.5 font-medium text-text transition hover:border-primary hover:text-primary"
              >
                Ya tengo cuenta
              </a>
            </>
          )
        }
      </div>

      <dl class="mt-16 grid gap-4 sm:grid-cols-3">
        <div class="rounded-card border border-border bg-surface p-5">
          <dt class="text-sm text-text-soft">Umbral mínimo</dt>
          <dd class="mt-1 text-2xl font-semibold text-primary-bright">
            {GAME_PREVIEW.baseMinutes} min
          </dd>
        </div>
        <div class="rounded-card border border-border bg-surface p-5">
          <dt class="text-sm text-text-soft">Refugio inicial</dt>
          <dd class="mt-1 text-2xl font-semibold text-accent">
            {GAME_PREVIEW.startDogs} perritos
          </dd>
        </div>
        <div class="rounded-card border border-border bg-surface p-5">
          <dt class="text-sm text-text-soft">Día programado sin leer</dt>
          <dd class="mt-1 text-2xl font-semibold text-alert">
            −{GAME_PREVIEW.penaltyPerMiss} perrito
          </dd>
        </div>
      </dl>
    </main>
  </div>
</BaseLayout>
