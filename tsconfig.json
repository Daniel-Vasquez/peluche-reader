{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    // TypeScript 7 eliminó `baseUrl`: los paths se resuelven relativos a este archivo.
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
