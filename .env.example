# =============================================================================
#  reading-app · Variables de entorno
#  Copia este archivo a `.env` y rellena los valores reales.
#  NUNCA subas `.env` al repositorio (ya está en .gitignore).
# =============================================================================
#
#  ⚠  LOS VALORES VAN SIN COMILLAS.
#
#  El panel de Vercel no limpia lo que pegas: si copias un valor con comillas,
#  las comillas pasan a formar parte del valor y rompen cosas en silencio.
#  `new URL('"https://…"')` lanza «Invalid URL» —tumba el build y la
#  autenticación— y el driver de Mongo no reconoce el esquema `"mongodb+srv://`.
#
#  Excepción: si un valor contiene `#` o espacios (por ejemplo una contraseña de
#  Mongo), enciérralo entre comillas **solo en tu `.env` local**, porque dotenv
#  trataría el `#` como comienzo de comentario. El código quita las comillas
#  envolventes al leer, así que hacerlo es inofensivo.
#
# =============================================================================

# -----------------------------------------------------------------------------
# 1. BASE DE DATOS (MongoDB)
#    Usadas por src/lib/db/client.ts y por el adaptador de Better Auth.
#    Se usa el driver NATIVO `mongodb` (no mongoose): Better Auth requiere una
#    instancia `Db` del driver nativo y así evitamos dos conexiones en serverless.
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://usuario:password@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=reading_app

# -----------------------------------------------------------------------------
# 2. AUTENTICACIÓN (Better Auth)
# -----------------------------------------------------------------------------
# Secreto para firmar cookies y tokens de sesión. Mínimo 32 caracteres.
# Genéralo con:  openssl rand -base64 32
BETTER_AUTH_SECRET=reemplazar-por-un-secreto-aleatorio-de-32-chars-o-mas

# URL base del servidor de auth, con protocolo y sin barra final.
# Local:      http://localhost:4321
# Producción: https://tu-proyecto.vercel.app
BETTER_AUTH_URL=http://localhost:4321

# La misma URL, expuesta al bundle del cliente (React la necesita para construir
# el authClient). El prefijo PUBLIC_ es obligatorio en Astro.
PUBLIC_BETTER_AUTH_URL=http://localhost:4321

# -----------------------------------------------------------------------------
# 3. APLICACIÓN
# -----------------------------------------------------------------------------
# URL pública del sitio, usada por Astro como `site` en astro.config.mjs.
# Tiene que ser una URL absoluta CON protocolo. Si llega mal, el build cae a
# http://localhost:4321 y avisa por consola en vez de fallar.
PUBLIC_SITE_URL=http://localhost:4321

# Zona horaria IANA por defecto al crear un perfil. El cliente autodetecta la
# suya con Intl.DateTimeFormat(); esto es solo el respaldo del servidor.
PUBLIC_DEFAULT_TIMEZONE=America/Mexico_City

# Nombre visible de la app (títulos y metadatos).
PUBLIC_APP_NAME=Peluche Reader

# -----------------------------------------------------------------------------
# 4. SCRIPTS DE MANTENIMIENTO (solo local)
# -----------------------------------------------------------------------------
# Interruptor de seguridad de `npm run db:reset`. El script se niega a borrar
# nada si esta variable no vale exactamente `yes`. Déjala en `no` en Vercel.
ALLOW_DB_RESET=no

# Usuario semilla que crea `npm run db:seed` (datos de demostración).
SEED_USER_EMAIL=demo@reading-app.local
SEED_USER_PASSWORD=demo12345

# -----------------------------------------------------------------------------
# 5. NOTAS DE DESPLIEGUE (Vercel)
# -----------------------------------------------------------------------------
# - Replica TODAS las variables anteriores en Vercel > Settings > Environment
#   Variables (scopes: Production, Preview y Development).
# - En Vercel, BETTER_AUTH_URL / PUBLIC_BETTER_AUTH_URL / PUBLIC_SITE_URL deben
#   apuntar al dominio final con https://, no a localhost.
# - `VERCEL_URL` la inyecta Vercel automáticamente: NO la definas aquí.
# - En MongoDB Atlas > Network Access permite 0.0.0.0/0 (las funciones de Vercel
#   no tienen IP fija) o configura una integración de IPs estáticas.
