# =============================================================================
#  reading-app · Variables de entorno
#  Copia este archivo a `.env` y rellena los valores reales.
#  NUNCA subas `.env` al repositorio (debe estar en .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. BASE DE DATOS (MongoDB)
#    Usadas por: src/lib/db/client.ts y por el adaptador de Better Auth.
#    Se usa el driver NATIVO `mongodb` (no mongoose): Better Auth requiere una
#    instancia `Db` del driver nativo y así evitamos dos conexiones en serverless.
# -----------------------------------------------------------------------------
MONGODB_URI="mongodb+srv://usuario:password@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="reading_app"

# -----------------------------------------------------------------------------
# 2. AUTENTICACIÓN (Better Auth)
# -----------------------------------------------------------------------------
# Secreto para firmar cookies/tokens de sesión. Mínimo 32 caracteres.
# Genéralo con:  openssl rand -base64 32
BETTER_AUTH_SECRET="reemplazar-por-un-secreto-aleatorio-de-32-chars-o-mas"

# URL base del servidor de auth (sin barra final).
# Local:      http://localhost:4321
# Producción: https://tu-proyecto.vercel.app
BETTER_AUTH_URL="http://localhost:4321"

# Misma URL, pero expuesta al bundle del cliente (React la necesita para
# construir el authClient). El prefijo PUBLIC_ es obligatorio en Astro.
PUBLIC_BETTER_AUTH_URL="http://localhost:4321"

# -----------------------------------------------------------------------------
# 3. APLICACIÓN
# -----------------------------------------------------------------------------
# URL pública del sitio (usada por Astro en astro.config.mjs -> `site`).
PUBLIC_SITE_URL="http://localhost:4321"

# Zona horaria IANA por defecto al crear un perfil nuevo. El cliente intentará
# autodetectarla con Intl.DateTimeFormat(); esto es solo el fallback del server.
PUBLIC_DEFAULT_TIMEZONE="America/Bogota"

# Nombre visible de la app (títulos, metadatos).
PUBLIC_APP_NAME="Peluche Reader"

# -----------------------------------------------------------------------------
# 4. SCRIPTS DE MANTENIMIENTO (opcional, solo local)
# -----------------------------------------------------------------------------
# Interruptor de seguridad para `npm run db:reset`. El script se niega a borrar
# colecciones si esta variable no vale exactamente "yes".
ALLOW_DB_RESET="no"

# Email del usuario semilla que crea `npm run db:seed` (datos de demo).
SEED_USER_EMAIL="demo@reading-app.local"
SEED_USER_PASSWORD="demo12345"

# -----------------------------------------------------------------------------
# 5. NOTAS DE DESPLIEGUE (Vercel)
# -----------------------------------------------------------------------------
# - Replica TODAS las variables anteriores en Vercel > Settings > Environment
#   Variables (scopes: Production, Preview y Development).
# - En Vercel, BETTER_AUTH_URL / PUBLIC_BETTER_AUTH_URL / PUBLIC_SITE_URL deben
#   apuntar al dominio final (https://...), no a localhost.
# - `VERCEL_URL` la inyecta Vercel automáticamente: NO la definas aquí.
# - En MongoDB Atlas > Network Access permite 0.0.0.0/0 (las funciones de Vercel
#   no tienen IP fija) o configura una integración de IPs estáticas.
